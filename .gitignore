# Provider and module downloads
.terraform/
.terraform.tfstate.lock.info

# State files: may contain secrets, never commit
*.tfstate
*.tfstate.*

# Saved plan files: binary, may contain secrets
*.tfplan
tfplan

# Variable files: often hold credentials
*.tfvars
*.tfvars.json

# Crash logs
crash.log
crash.*.log

# CLI config with credentials
.terraformrc
terraform.rc

# macOS
.DS_Store